{
  "name": "frontend-ng",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "lint:fix": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "type-check": "tsc --noEmit"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.6.4",
  "dependencies": {
    "@analogjs/vitest-angular": "^2.9.7",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/platform-browser-dynamic": "^22.3.0",
    "@angular/router": "^22.3.0",
    "bootstrap": "^5.3.9",
    "bootstrap-icons": "^1.13.2",
    "rxjs": "~7.8.2",
    "sass-migrator": "^2.7.0",
    "tslib": "^2.9.1",
    "zone.js": "^0.16.3"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "^2.9.7",
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "jsdom": "^31.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
